    line-height: 1.6;
    color: #555;
    position: relative;
    padding-left: 25px;
}

.product-features li:before, .product-benefits li:before, .product-why-choose li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #4a7c59;
    font-weight: bold;
}

.product-price {
