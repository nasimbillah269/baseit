# Copy these into the LIVE server's .env (keep the live APP_KEY and DB_* values).
APP_NAME="BASE IT"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.baseit.com.bd

LOG_CHANNEL=stack
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Debugbar must never run on the live site
DEBUGBAR_ENABLED=false
