# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Force HTTPS on the live server (skip localhost / 127.0.0.1)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # SECURITY: the app lives in this folder, so block every internal folder and hidden file from the web.
    # (.env, storage/ = logs, sessions, CVs, DB backups; vendor/, config/, database/ ...)
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|lang|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|README\.md|error_log|server\.php)$ - [F,L]
    RewriteRule \.(env|log|sql|sqlite|bak|backup|old|orig|swp|ini|sh|yml|yaml|lock|dist|md)$ - [F,L,NC]

    # sitemap.xml is generated by the app (ignore any old static sitemap.xml file)
    RewriteRule ^sitemap\.xml$ index.php [L]

    # Static files (css, js, images, fonts ...) live in public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} \.(css|js|map|png|jpe?g|gif|webp|svg|ico|bmp|woff2?|ttf|eot|otf|mp4|webm|mp3|pdf|txt|apk)$ [NC]
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else -> Laravel
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Second line of defence if mod_rewrite is off
<FilesMatch "(?i)(^\.|\.(env|log|sql|sqlite|bak|lock|md|yml|yaml|ini|sh)$|^(artisan|composer\.json|package\.json|phpunit\.xml|vite\.config\.js|error_log)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header unset X-Powered-By
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
